; THROWAWAY: Phase 1 bake-off lane G-D (docs/bakeoff/README.md). Nothing here is canon.
config_version=5
[application]
config/name="violet bake-off lane G-D (THROWAWAY)"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
[autoload]
Actions="*res://bakeoff/actions.gd"
Resonance="*res://bakeoff/resonance.gd"
[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
[editor]
movie_writer/mjpeg_quality=1.0
[physics]
common/physics_ticks_per_second=60
common/physics_jitter_fix=0.0
common/physics_interpolation=false
[rendering]
renderer/rendering_method="forward_plus"
[shader_globals]
; No 3D shader reads it (world saturation is the environment's adjustment_saturation), but the shared
; bakeoff/resonance.gd sets it on every color change, and a rendering server without it logs an error each time.
world_saturation={"type": "float", "value": 0.35}
