{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sjawhar/project-violet/tools/provenance/schema/provenance-v1.json",
  "title": "Violet asset provenance record, version 1",
  "description": "Sidecar <asset>.provenance.json stored next to the asset it describes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "asset", "sha256", "kind", "origin", "created_at", "human_edits", "license"],
  "properties": {
    "schema_version": { "const": 1 },
    "asset": {
      "description": "File name of the asset, which sits in the same directory as the sidecar.",
      "type": "string",
      "pattern": "^[^/\\\\]+$"
    },
    "sha256": { "$ref": "#/$defs/sha256" },
    "kind": { "enum": ["image", "model3d", "animation", "audio", "text", "other"] },
    "origin": { "enum": ["generated", "human", "derived"] },
    "created_at": { "type": "string", "format": "date-time" },
    "generator": { "$ref": "#/$defs/generator" },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonempty" }
    },
    "human_edits": {
      "type": "array",
      "items": { "$ref": "#/$defs/human_edit" }
    },
    "license": { "$ref": "#/$defs/nonempty" },
    "source_url": { "type": "string", "format": "uri" }
  },
  "if": {
    "properties": { "origin": { "const": "human" } },
    "required": ["origin"]
  },
  "then": {
    "required": ["authors"],
    "properties": { "generator": { "not": {} } }
  },
  "else": {
    "required": ["generator"]
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "tool_version", "provider", "model", "prompt", "params", "inputs"],
      "properties": {
        "tool": { "$ref": "#/$defs/nonempty" },
        "tool_version": { "$ref": "#/$defs/nonempty" },
        "provider": { "$ref": "#/$defs/nonempty" },
        "model": { "$ref": "#/$defs/nonempty" },
        "model_version": { "$ref": "#/$defs/nonempty" },
        "prompt": { "$ref": "#/$defs/nonempty" },
        "negative_prompt": { "$ref": "#/$defs/nonempty" },
        "seed": { "type": "integer", "minimum": 0 },
        "params": { "type": "object" },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "$ref": "#/$defs/nonempty" },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "human_edit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by", "description", "at"],
      "properties": {
        "by": { "$ref": "#/$defs/nonempty" },
        "description": { "$ref": "#/$defs/nonempty" },
        "at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
